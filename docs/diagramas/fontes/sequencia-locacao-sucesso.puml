@startuml
actor Vendedor
participant "LocadoraService" as Service
participant "RepositorioJSON" as Repo
participant "Cliente" as Cliente
participant "Veiculo" as Veiculo
participant "Locacao" as Locacao
participant "Pagamento" as Pagamento

Vendedor -> Service: realizar_locacao(cpf, placa, data_prevista, tipo_pagamento)
Service -> Service: _buscar_cliente(cpf)
Service --> Service: cliente
Service -> Service: _buscar_veiculo(placa)
Service --> Service: veiculo
Service -> Veiculo: esta_disponivel()
Veiculo --> Service: true
Service -> Locacao: <<create>> Locacao(cliente, vendedor, veiculo, datas)
Service -> Locacao: calcular_valor_total()
Locacao --> Service: valor_total
Service -> Pagamento: <<create>> Pagamento(tipo_pagamento, valor_total)
Service -> Locacao: adicionar_pagamento(pagamento)
Service -> Veiculo: alterar_disponibilidade(false)
Service -> Repo: salvar(dados_atualizados)
Repo --> Service: confirmado
Service --> Vendedor: locacao_confirmada(locacao, recibo)
@enduml
