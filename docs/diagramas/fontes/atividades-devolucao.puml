@startuml
|Vendedor|
start
:Informar placa do veiculo;
|Sistema|
:Buscar locacao ativa pela placa;
if (Locacao ativa encontrada?) then (sim)
  |Vendedor|
  :Informar data real da devolucao;
  |Sistema|
  :Comparar data real com a prevista;
  if (Houve atraso?) then (sim)
    :Calcular multa por atraso;
    |Vendedor|
    :Informar forma de pagamento da multa;
    |Sistema|
    :Registrar pagamento da multa;
  else (nao)
    :Nao cobrar multa;
  endif
  :Finalizar locacao;
  :Marcar veiculo como disponivel;
  :Salvar dados em JSON;
  :Exibir comprovante de devolucao;
else (nao)
  :Informar que nao ha locacao ativa;
endif
stop
@enduml
