@startuml
actor Vendedor
participant "LocadoraService" as Service
participant "Veiculo" as Veiculo

Vendedor -> Service: realizar_locacao(cpf, placa, data_prevista, tipo_pagamento)
Service -> Service: _buscar_veiculo(placa)
Service --> Service: veiculo
Service -> Veiculo: esta_disponivel()
Veiculo --> Service: false
Service --> Vendedor: ErroLocadora("Veiculo indisponivel")
note over Service, Veiculo
  A locacao e o pagamento nao sao criados.
  O estado persistido nao e alterado.
end note
@enduml
