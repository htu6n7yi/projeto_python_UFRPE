@startuml
left to right direction
actor Vendedor

rectangle "Sistema de Locadora de Veiculos" {
  usecase "Cadastrar cliente" as UC_CadastrarCliente
  usecase "Cadastrar veiculo" as UC_CadastrarVeiculo
  usecase "Consultar veiculos" as UC_ConsultarVeiculos
  usecase "Filtrar por disponibilidade" as UC_Filtrar
  usecase "Realizar locacao" as UC_RealizarLocacao
  usecase "Validar disponibilidade" as UC_Validar
  usecase "Registrar pagamento" as UC_Pagamento
  usecase "Registrar devolucao" as UC_Devolucao
  usecase "Calcular multa por atraso" as UC_Multa
}

Vendedor --> UC_CadastrarCliente
Vendedor --> UC_CadastrarVeiculo
Vendedor --> UC_ConsultarVeiculos
Vendedor --> UC_RealizarLocacao
Vendedor --> UC_Devolucao

UC_Filtrar .> UC_ConsultarVeiculos : <<extend>>
UC_RealizarLocacao .> UC_Validar : <<include>>
UC_RealizarLocacao .> UC_Pagamento : <<include>>
UC_Multa .> UC_Devolucao : <<extend>>
@enduml
