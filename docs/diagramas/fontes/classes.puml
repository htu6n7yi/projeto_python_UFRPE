@startuml
skinparam classAttributeIconSize 0

abstract class Pessoa {
  # _nome: str
  # _idade: int
  # _telefone: str
  # _email: str
  + nome: str
  + {abstract} exibir_dados(): str
}

class Cliente {
  + cpf: str
  + exibir_dados(): str
}

class Vendedor {
  + ctps: str
  + exibir_dados(): str
}

class Veiculo {
  - _marca: str
  - _modelo: str
  - _cor: str
  - _placa: str
  - _preco_diaria: Decimal
  - _disponivel: bool
  + placa: str
  + preco_diaria: Decimal
  + disponivel: bool
  + esta_disponivel(): bool
  + alterar_disponibilidade(status: bool): None
  + exibir_dados(): str
}

class Locacao {
  - _data_locacao: date
  - _data_devolucao_prevista: date
  - _data_devolucao_real: Optional[date]
  - _status: str
  - _pagamentos: list[Pagamento]
  + adicionar_pagamento(pagamento: Pagamento): None
  + calcular_valor_total(): Decimal
  + calcular_multa(data_real: date): Decimal
  + finalizar(data_real: date): None
}

class Pagamento {
  - _tipo: str
  - _valor: Decimal
  + tipo: str
  + valor: Decimal
  + exibir_recibo(): str
}

class LocadoraService {
  - _clientes: dict[str, Cliente]
  - _veiculos: dict[str, Veiculo]
  - _locacoes: list[Locacao]
  - _buscar_cliente(cpf: str): Cliente
  - _buscar_veiculo(placa: str): Veiculo
  + cadastrar_cliente(cliente: Cliente): None
  + cadastrar_veiculo(veiculo: Veiculo): None
  + consultar_veiculos(disponivel: bool | None): list[Veiculo]
  + realizar_locacao(cpf: str, placa: str, data_prevista: date, tipo_pagamento: str): Locacao
  + registrar_devolucao(placa: str, data_real: date, tipo_pagamento: str): Locacao
}

class RepositorioJSON {
  - _caminho: Path
  + carregar(): dict
  + salvar(dados: dict): None
}

class ErroLocadora {
  + mensagem: str
}

Cliente --|> Pessoa
Vendedor --|> Pessoa
ErroLocadora --|> Exception

Cliente "1" -- "0..*" Locacao : realiza
Vendedor "1" -- "0..*" Locacao : registra
Veiculo "1" -- "0..*" Locacao : aparece em
Locacao "1" *-- "1..*" Pagamento : possui

LocadoraService ..> Cliente : gerencia
LocadoraService ..> Veiculo : gerencia
LocadoraService ..> Locacao : cria e finaliza
LocadoraService "1" --> "1" RepositorioJSON : carrega/salva
LocadoraService ..> ErroLocadora : sinaliza
@enduml
